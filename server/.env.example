# ==========================================
# SVITS ERP Backend - Environment Variables
# ==========================================

# 1. Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# 2. Database (MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/svits_erp
MONGO_URI=mongodb://localhost:27017/svits_erp

# 3. Redis (Background Jobs & Caching)
REDIS_URL=rediss://default:<password>@your-endpoint.upstash.io:6379

# 4. Authentication (JWT)
JWT_SECRET=<YOUR_SECURE_JWT_SECRET_KEY>
JWT_EXPIRE=30d

# 5. Cloudinary (File Uploads)
CLOUDINARY_CLOUD=<YOUR_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_SECRET=<YOUR_CLOUDINARY_API_SECRET>

# 6. Google OAuth (Optional)
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# 7. Gemini AI (Campus Assistant)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# 8. SMTP Email Config (For Password Resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_GMAIL_ADDRESS>
SMTP_PASS=<YOUR_GMAIL_APP_PASSWORD>
FROM_EMAIL="SVITS ERP" <noreply@svits.edu>
